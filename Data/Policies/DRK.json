        {
          "id": "prevent-blood-overcap-before-souleater",
          "type": "preventResourceOvercap",
          "lane": "gcd",
          "priority": 900,
          "action": "bloodspiller",
          "resource": "blood",
          "threshold": 80,
          "incomingAction": "souleater",
          "incomingGain": 20,
          "reason": "Spend Blood before Souleater would overcap the gauge.",
          "mistakeResponse": "keepProgress"
        },
        {
          "id": "spend-free-dark-arts",
          "type": "useAction",
          "lane": "weave",
          "priority": 850,
          "action": "edgeOfShadow",
          "conditions": {
            "all": [
              {
                "source": "stateValue",
                "key": "darkArts",
                "operator": "equal",
                "value": true
              }
            ]
          },
          "suggestionReason": "Use the free Dark Arts Edge before it is overwritten."
        },
        {
          "id": "prevent-mp-overcap",
          "type": "preventResourceOvercap",
          "lane": "weave",
          "priority": 800,
          "action": "edgeOfShadow",
          "resource": "mp",
          "threshold": 9000,
          "reason": "Weave Edge to avoid overcapping MP."
        },
        {
          "id": "refresh-darkside",
          "type": "useAction",
          "lane": "weave",
          "priority": 700,
          "action": "edgeOfShadow",
          "conditions": {
            "all": [
              {
                "source": "stateValue",
                "key": "darksideMs",
                "operator": "lessThanOrEqual",
                "value": 10000
              },
              {
                "source": "stateValue",
                "key": "mp",
                "operator": "greaterThanOrEqual",
                "value": 3000
              }
            ]
          },
          "suggestionReason": "Refresh Darkside with Edge before it expires."
        },
        {
          "id": "use-delirium",
          "type": "useCooldown",
          "lane": "weave",
          "priority": 600,
          "action": "delirium",
          "cooldown": "delirium",
          "conditions": {
            "all": [
              {
                "source": "acceptedActionCount",
                "operator": "greaterThan",
                "value": 0
              }
            ],
            "none": [
              {
                "source": "statusActive",
                "key": "delirium",
                "operator": "equal",
                "value": true
              }
            ]
          },
          "suggestionReason": "Delirium is ready; weave it to begin the next burst cycle."
        },
        {
          "id": "continue-souleater-combo",
          "type": "continueCombo",
          "lane": "gcd",
          "priority": 100,
          "combo": "souleater",
          "reason": "Continue the current Souleater combo.",
